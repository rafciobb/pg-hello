# ─── Produkcja (docker compose) ───────────────────────────────────────────
# Domena, pod którą będzie panel (rekord DNS A musi wskazywać na IP serwera)
DOMAIN=panel.twojadomena.pl

# Baza danych – hasło wygeneruj: openssl rand -hex 24  (same litery/cyfry!)
POSTGRES_USER=digguj
POSTGRES_PASSWORD=
POSTGRES_DB=digguj

# Sekret sesji – wygeneruj: openssl rand -hex 32
SESSION_SECRET=

# Maksymalny rozmiar przesyłanego zdjęcia (MB)
MAX_UPLOAD_MB=25

# ─── Tylko praca lokalna (npm run dev) ────────────────────────────────────
# DATABASE_URL=postgres://digguj:haslo@localhost:5432/digguj
# COOKIE_SECURE=false
# PORT=3000
